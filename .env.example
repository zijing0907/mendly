# Copy this file to .env and adjust for your machine.
# These defaults match a stock XAMPP install.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=mendly_db

# --- Email (optional) -------------------------------------------------
# Leave MAIL_HOST empty for demo mode: password reset links are shown on
# screen instead of emailed. Fill these in to send real emails.
#
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Mendly

# Public address of the site, used for links inside emails.
# Set this when the site is online, e.g. https://mendly.example.com
APP_URL=

# --- AI features (optional, free) -------------------------------------
# A free Gemini API key turns on the "Ask Mendly" AI answers and the photo
# safety check: https://aistudio.google.com/apikey
# Without a key the helper still answers from built-in search + FAQ, and
# photos are accepted without a check.
# Note: on Gemini's free tier Google may use what is sent to improve its
# products - fine for demo data, not for real customers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Most AI helper answers per day (protects the free quota)
AI_DAILY_LIMIT=300
